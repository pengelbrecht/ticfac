# Build output. `/ticfac` is the built binary; `!/ticfac/` un-ignores the
# directory of the same name (SPEC §12 Phase 4: the factory worker bundle
# moved there as ticfac/cloudflare), so a new file under it can never be
# silently skipped by `git add`.
/ticfac
!/ticfac/
/bin/

# Go test and coverage artefacts
*.test
*.out
coverage.*

# BEGIN ticfac run state
# .ticfac/runs/** is COMMITTED — it is the run's durable record (SPEC 10.4),
# and durable means pushed on origin. Only these two are exhaust:
.ticfac/.index.json
.ticfac/logs/
# END ticfac run state
