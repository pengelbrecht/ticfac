{
  "name": "ticks-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "mint-token": "node scripts/mint-factory-token.mjs",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:test": "node --test --no-warnings scripts/contracts.test.mjs",
    "contracts:sync": "node scripts/contracts.mjs sync",
    "lint": "biome ci --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "pnpm contracts:check && tsc --noEmit",
    "test": "pnpm contracts:check && pnpm contracts:test && vitest run",
    "test:watch": "pnpm contracts:check && vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260815.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.7"
  }
}
